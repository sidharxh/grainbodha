# Public production site URL used for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Configure Resend for transactional enquiry email.
RESEND_API_KEY=re_your_api_key
INQUIRY_FROM_EMAIL=Grainbodha Website <website@your-verified-domain.example>
CONTACT_EMAIL=orders@your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=orders@your-domain.example
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number in international format, digits only, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=
